GOOGLE_CLOUD_PROJECT=datavision-482713
GOOGLE_CLOUD_REGION=us-central1
# Gemini 3.x text models may only be served from the global endpoint.
GEMINI_LOCATION=global
ASSET_BUCKET=tp-assets-datavision-482713
# Needed locally when signing URLs with user ADC; the runtime SA signs itself on Cloud Run.
SIGNING_SA_EMAIL=tp-runtime@datavision-482713.iam.gserviceaccount.com

# Confirm exact IDs with: python scripts/smoke_test.py --list
MODEL_FLASH=gemini-3.8-flash
MODEL_LITE=gemini-3.5-flash-lite
MODEL_PRO=gemini-3.1-pro-preview
MODEL_IMAGE=gemini-nano-banana-2.1
MODEL_VTO=virtual-try-on-001
MODEL_VIDEO=veo-3.1-fast-generate-001
MODEL_LIVE=gemini-3.8-live
# Live models are not served from the global endpoint.
LIVE_LOCATION=us-central1

# off | record (save golden path) | fallback (cache on error/timeout) | replay (cache only)
DEMO_MODE=off
DEMO_TIMEOUT_S=25

ALLOWED_ORIGINS=http://localhost:3000
# Local-only shortcut; ignored on Cloud Run.
AUTH_DISABLED=false
